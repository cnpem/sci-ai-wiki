# Folder that contains GEMINI.md, wiki/, and .agents/skills/
WIKI_PATH=/Users/luizlopes/Documents/Mestrado/graph

# Antigravity CLI executable, request timeout, and optional model override.
AGY_BIN=agy
AGY_TIMEOUT_SECONDS=300
AGY_MODEL=
# Optional: use only to move the Antigravity settings file.
# AGY_SETTINGS_PATH=/Users/you/.gemini/antigravity-cli/settings.json

# Optional local alternative: OpenCode using a model served by Ollama.
OPENCODE_BIN=opencode
OPENCODE_MODEL=ollama/gemma4:31b
OPENCODE_TIMEOUT_SECONDS=600

# Optional Codex CLI. Leave CODEX_MODEL blank to use the account/default model.
CODEX_BIN=codex
CODEX_MODEL=
CODEX_TIMEOUT_SECONDS=600
